    school {
        bigint id PK
        string census_no
        string name
        enum type
        string province
        string zone
    }
    app_user {
        bigint id PK
        bigint school_id FK
        bigint teacher_id FK
        string email
        enum role
    }
    teacher {
        bigint id PK
        bigint school_id FK
        string staff_no
        string full_name
        int max_periods_day
        int max_periods_week
    }
    academic_year {
        bigint id PK
        bigint school_id FK
        int year
    }
    term {
        bigint id PK
        bigint academic_year_id FK
        int term_no
        date start_date
        date end_date
    }
    time_slot {
        bigint id PK
        bigint school_id FK
        int day_of_week
        int period_no
        time start_time
        time end_time
        enum slot_type
    }
    grade {
        bigint id PK
        bigint school_id FK
        int grade_no
        enum level
    }
    stream {
        bigint id PK
        bigint school_id FK
        string name
    }
    class_group {
        bigint id PK
        bigint academic_year_id FK
        bigint grade_id FK
        smallint medium_id FK
        bigint stream_id FK
        bigint class_teacher_id FK
        string name
    }
    subject {
        bigint id PK
        bigint school_id FK
        string code
        string name_en
        string name_si
        string name_ta
        bool is_religion
    }
    room {
        bigint id PK
        bigint school_id FK
        string name
        enum type
        int capacity
    }
    lesson_group {
        bigint id PK
        bigint academic_year_id FK
        enum type
        string name
    }
    lesson {
        bigint id PK
        bigint subject_id FK
        bigint teacher_id FK
        bigint lesson_group_id FK
        int periods_per_week
        int block_size
        int max_per_day
        enum required_room_type
    }
    lesson_class {
        bigint lesson_id PK
        bigint class_group_id PK
        int student_count
    }
    solve_job {
        bigint id PK
        bigint term_id FK
        enum status
        int best_hard_score
        int best_soft_score
    }
    timetable_version {
        bigint id PK
        bigint term_id FK
        bigint solve_job_id FK
        string name
        enum status
    }
    timetable_entry {
        bigint id PK
        bigint version_id FK
        bigint lesson_id FK
        bigint time_slot_id FK
        bigint room_id FK
        bool is_pinned
    }
    teacher_absence {
        bigint id PK
        bigint teacher_id FK
        date absent_date
    }
    substitution {
        bigint id PK
        bigint absence_id FK
        bigint timetable_entry_id FK
        bigint substitute_teacher_id FK
    }
